[Unit]
Description=FFN aggregate %i CP/DP owner
After=network-online.target ffn-controld.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/ffn-ngfw-v2/venv/bin/python /opt/ffn-platforms/pa5200-management/aggregate_activation.py serve %i
TimeoutStopSec=60
KillMode=control-group
# The supervisor verifies withdrawal and current CP/DP identities on every
# retry. Uncertain ownership stays blocked; no stale acknowledgement is reused.
Restart=on-failure
RestartSec=10
