[Unit]
Description=FFN MP-owned dataplane interface management services
Requires=ffn-controld.service
After=ffn-controld.service
PartOf=ffn-controld.service

[Service]
ExecStart=/opt/ffn-ngfw-v2/venv/bin/python /opt/ffn-platforms/pa5200-management/interface_services.py
Restart=always
RestartSec=5
UMask=0077
KillMode=control-group

[Install]
WantedBy=multi-user.target
