[Unit]
Description=FFN PA-5200 MP session observation relay to FE100 control plane
After=network-online.target ffn-controld.service
Wants=network-online.target
Requires=ffn-controld.service
PartOf=ffn-controld.service
ConditionPathExists=/opt/ffn-platforms/pa5200-management/extension.json
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/ffn-ngfw-v2/venv/bin/python /opt/ffn-platforms/pa5200-management/session_relay.py
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
