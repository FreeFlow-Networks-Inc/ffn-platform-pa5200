[Unit]
Description=FFN DP exports through Debian's native NFS server
Requires=nfs-server.service
After=local-fs.target network.target nfs-server.service
# The MP provisions the export path, exact transport client and filesystem ID.
# No appliance-specific export or address is included in the image.
ConditionPathExists=/etc/exports.d/ffn-dp.exports
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/exportfs -r
ExecReload=/usr/sbin/exportfs -r
TimeoutStartSec=90
[Install]
WantedBy=multi-user.target
