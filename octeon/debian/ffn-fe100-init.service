[Unit]
Description=FFN FE100 datapath initialisation (blocks, TCAM, DDR, flow memory, FLU, SEM)
Requires=ffn-fe100-links.service
After=ffn-fe100-links.service
PartOf=ffn-bcmd.service

[Service]
Type=oneshot
Environment=LD_PRELOAD=/usr/lib/mips64-linux-gnuabi64/libsqlite3.so.0
Environment=LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib64/3p:/usr/local/lib/ffn/owner-deps
ExecStart=/usr/bin/python3 -u /usr/local/sbin/ffn_fe100_init.py run
RemainAfterExit=yes
TimeoutStartSec=900
TimeoutStopSec=20
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
