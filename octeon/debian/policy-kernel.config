# Merge into an isolated copy of the commissioned DP kernel configuration.
# These are prerequisites; they do not qualify any policy provider for use.
CONFIG_MODULES=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NFT_NAT=y
CONFIG_NFT_NUMGEN=m
CONFIG_NFT_HASH=m
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_HTB=m
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_CLS=y
CONFIG_NET_CLS_FW=m
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_TPROXY_IPV4=m
CONFIG_NFT_TPROXY=m
