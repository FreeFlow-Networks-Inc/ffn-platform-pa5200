[Unit]
Description=Forward the management plane's service-route traffic to the dataplane
Documentation=file:/usr/local/sbin/ffn_service_route_forward.sh
After=ffn-dpnet.service network.target
Wants=ffn-dpnet.service

# A policy rule in this namespace moves every 127/8 lookup into the local table,
# where lo's 127.0.0.0/8 claims the MP (127.1.1.1): NFS root frozen, MP packets
# dropped as martian sources (PA-5220, 2026-10-15 01:27). Nothing may add a rule
# here until the transport bring-up has shrunk lo's local scope to 127.0.0.0/24
# and recorded that in this file.
ConditionPathExists=/run/ffn-loopback-scope-127.0.0.0-24

[Service]
Type=oneshot
RemainAfterExit=yes
# The MP sends routed services (DNS, NTP, updates ...) from 127.1.1.1 over
# ffnnet0 with the CP as next hop; the CP forwards exactly that source to the
# DP over ffndp0 and nothing else. Replies follow the main table back.
ExecStart=/usr/local/sbin/ffn_service_route_forward.sh
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
