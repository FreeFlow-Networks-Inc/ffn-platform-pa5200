[Unit]
Description=FFN PA-5200 OCTEON dataplane readiness agent
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/sbin/ffn_dp_agent.py serve
RuntimeDirectory=ffn-dp-agent
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
