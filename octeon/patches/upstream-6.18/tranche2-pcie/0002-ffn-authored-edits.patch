+
+/*
+ * FFN: ported from the OCTEON SDK's cvmx-helper-jtag.c. Upstream carries
+ * init/shift/shift_zeros/update from this file but not capture, which
+ * cvmx-qlm.c needs in cvmx_qlm_init, cvmx_qlm_jtag_get and
+ * cvmx_qlm_jtag_set. Same unions, registers and self-clearing poll as
+ * cvmx_helper_qlm_jtag_update() directly above.
+ */
+void cvmx_helper_qlm_jtag_capture(int qlm)
+{
+	union cvmx_ciu_qlm_jtgc jtgc;
+	union cvmx_ciu_qlm_jtgd jtgd;
+
+	jtgc.u64 = cvmx_read_csr(CVMX_CIU_QLM_JTGC);
+	jtgc.s.mux_sel = qlm;
+	if (OCTEON_IS_OCTEON1PLUS())
+		jtgc.s.bypass = 1 << qlm;
+
+	cvmx_write_csr(CVMX_CIU_QLM_JTGC, jtgc.u64);
+	cvmx_read_csr(CVMX_CIU_QLM_JTGC);
+
+	jtgd.u64 = 0;
+	jtgd.s.capture = 1;
+	if (!OCTEON_IS_MODEL(OCTEON_CN56XX_PASS1_X))
+		jtgd.s.select = 1 << qlm;
+	cvmx_write_csr(CVMX_CIU_QLM_JTGD, jtgd.u64);
+	do {
+		jtgd.u64 = cvmx_read_csr(CVMX_CIU_QLM_JTGD);
+	} while (jtgd.s.capture);
+}
