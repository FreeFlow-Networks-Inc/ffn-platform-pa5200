+# FFN: OCTEON III PCIe support.
+#
+# Upstream inlined an old, OCTEON I/II-only copy of the cvmx PCIe code into
+# arch/mips/pci/pcie-octeon.c: it reads MIO_RST_CTL and CIU_SOFT_PRST, which do
+# not exist on CN7XXX, and its port index is masked & 1 so it can only address
+# two PEMs where OCTEON III has four. Booting that on a PA-5220 CN73XX takes a
+# Data bus error in cvmx_pcie_rc_initialize and panics in PID 1.
+#
+# These are the SDK files, which are CN7XXX-aware -- RST_CTL / RST_SOFT_PRST,
+# four PEMs per node, node:port addressing -- with arch/mips/pci/pcie-octeon.c
+# reduced to the thin Linux glue the split expects.
+obj-y += cvmx-qlm.o cvmx-qlm-tables.o
+obj-$(CONFIG_PCI) += cvmx-pcie.o
+ccflags-y += -DCVMX_BUILD_FOR_LINUX_KERNEL=1 -DCVMX_ENABLE_CSR_ADDRESS_CHECKING=0
