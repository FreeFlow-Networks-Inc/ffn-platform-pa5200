 /* Exclude a single page from the regions obtained in plat_mem_setup. */
 #ifndef CONFIG_CRASH_DUMP
+
+/*
+ * FFN: ffn_reserve=<base>,<size>  -- keep MP-owned DRAM out of the allocator.
+ *
+ * FFN's CP<->MP transports (the cpdp and pcnet rings, and the staging area for
+ * an ffn_rootfs= overlay) live at fixed physical addresses. The MP writes them
+ * through the PCIe BAR window before Linux starts, and ffn_cpdpd / ffn_pcnetd
+ * then mmap them out of /dev/mem and keep writing. They are NOT cvmx_bootmem
+ * named blocks -- the bases are bare physical addresses the MP picks -- so
+ * plat_mem_setup() hands them to memblock like any other DRAM, and the buddy
+ * allocator will hand the same pages to somebody else. Measured on a PA-5220
+ * CN73XX: /proc/kpageflags at each base read 0x400 (KPF_BUDDY), the same as an
+ * arbitrary free page, while the daemons were writing them. CONFIG_DEVMEM
+ * without CONFIG_STRICT_DEVMEM, so the mmap succeeds silently.
+ *
+ * This is the 6.x form of the fix and it is far simpler than the 4.9 one.
+ * arch/mips no longer has boot_mem_map / add_memory_region / BOOT_MEM_RAM;
+ * plat_mem_setup() calls memblock_add() directly, so a reservation is just
+ * memblock_reserve() and there is no need to split the chunk as it is added.
+ *
+ * The parameter MAY BE REPEATED, and that is the form to prefer:
+ *
+ *     ffn_reserve=0x28000000,1M ffn_reserve=0x29000000,4M
+ *
+ * ';' is the u-boot command separator and this boot line is executed by u-boot,
+ * so an unescaped ';' truncates it and silently drops every argument after it --
+ * measured on a PA-5220 DP, where it took mem= and the pktbuf=/wqe= FPA sizing
+ * with it and u-boot booted the first half reporting nothing. A ';'-separated
+ * list is still accepted (a backslash-escaped '\;' survives u-boot), because a
+ * single script feeding many kernel versions is safer escaping in one place than
+ * relying on every kernel having this parser.
+ */
+#define FFN_RESERVE_MAX 8
+
+static struct {
+	u64 base;
+	u64 size;
+} ffn_reserve[FFN_RESERVE_MAX] __initdata;
+static int ffn_reserve_count __initdata;
+
+/* skip to the next entry, so one malformed entry costs only itself */
+static __init const char *ffn_reserve_next(const char *p)
+{
+	while (*p && *p != ';' && *p != ' ')
+		p++;
+	return (*p == ';') ? p + 1 : p;
+}
+
+static __init void ffn_reserve_parse_one(const char *p, int *rejected)
+{
+	while (*p && *p != ' ') {
+		u64 base, size, end;
+		char *endp;
+
+		if (ffn_reserve_count >= FFN_RESERVE_MAX) {
+			pr_warn("FFN: ffn_reserve: more than %d ranges, ignoring \"%s\"\n",
+				FFN_RESERVE_MAX, p);
+			return;
+		}
+
+		base = memparse(p, &endp);
+		if (endp == p || *endp != ',') {
+			pr_warn("FFN: ffn_reserve: expected <base>,<size> at \"%s\", skipping this entry\n",
+				p);
+			(*rejected)++;
+			p = ffn_reserve_next(p);
+			continue;
+		}
+		p = endp + 1;
+
+		size = memparse(p, &endp);
+		if (endp == p || !size) {
+			pr_warn("FFN: ffn_reserve: bad or zero size at \"%s\", skipping this entry\n",
+				p);
+			(*rejected)++;
+			p = ffn_reserve_next(p);
+			continue;
+		}
+		p = endp;
+
+		/* align outwards: a partial page must still be fully removed */
+		end = PAGE_ALIGN(base + size);
+		base &= PAGE_MASK;
+		ffn_reserve[ffn_reserve_count].base = base;
+		ffn_reserve[ffn_reserve_count].size = end - base;
+		ffn_reserve_count++;
+
+		if (*p != ';')
+			return;
+		p++;
+	}
+}
+
+/*
+ * Parse every occurrence, then apply. Reservations are applied AFTER
+ * plat_mem_setup() has finished adding memory, so a range is reserved whether
+ * or not the region it names was added -- memblock_reserve() on an address
+ * outside memblock.memory is harmless and still keeps it out of the allocator
+ * if it is added later.
+ */
+static __init void ffn_reserve_apply(void)
+{
+	const char *occ = arcs_cmdline;
+	int rejected = 0;
+	int i;
+
+	while ((occ = strstr(occ, "ffn_reserve=")) != NULL) {
+		occ += sizeof("ffn_reserve=") - 1;
+		if (ffn_reserve_count >= FFN_RESERVE_MAX)
+			break;
+		ffn_reserve_parse_one(occ, &rejected);
+	}
+
+	for (i = 0; i < ffn_reserve_count; i++) {
+		int rc = memblock_reserve(ffn_reserve[i].base,
+					  ffn_reserve[i].size);
+
+		if (rc) {
+			pr_err("FFN: ffn_reserve 0x%llx+0x%llx: memblock_reserve failed (%d) -- NOT protected\n",
+			       (unsigned long long)ffn_reserve[i].base,
+			       (unsigned long long)ffn_reserve[i].size, rc);
+			continue;
+		}
+		pr_info("FFN: ffn_reserve 0x%llx+0x%llx reserved, kept out of the allocator\n",
+			(unsigned long long)ffn_reserve[i].base,
+			(unsigned long long)ffn_reserve[i].size);
+	}
+
+	/*
+	 * Reported once, at error level. A rejected entry never reaches the
+	 * table, so nothing downstream can notice it -- and the failure mode
+	 * this whole parameter guards against is a region left quietly
+	 * unprotected while the boot line still reads exactly as intended.
+	 */
+	if (rejected)
+		pr_err("FFN: ffn_reserve: %d malformed entry/entries REJECTED -- the regions they named are NOT protected\n",
+		       rejected);
+}
 static __init void memory_exclude_page(u64 addr, u64 *mem, u64 *size)
 {
 	if (addr > *mem && addr < *mem + *size) {
