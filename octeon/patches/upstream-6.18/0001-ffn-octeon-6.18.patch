+
+/*
+ * FFN: find the device tree by NAME, and never dereference an unvalidated
+ * fdt_addr.
+ *
+ * Two separate problems, both live in this file upstream.
+ *
+ * 1. u-boot publishes the tree it built for the board as the cvmx_bootmem named
+ *    block "__fdt" (on a PA-5220 CP: base 0x80000, size 0x20000, holding a tree
+ *    with magic d00dfeed and totalsize 0x136f). Looking it up by name is what
+ *    the vendor's own control-plane software does for every region it needs, and
+ *    it removes a per-board constant: each reclaimed board knows where its own
+ *    tree is, so ask the board. ffn_fdt=<addr> is kept as an override.
+ *
+ * 2. The octeon_bootinfo->fdt_addr path below dereferences phys_to_virt() of an
+ *    address it has not bounds-checked. On the PCIe / L2-cache boot path that
+ *    field is left UNINITIALISED -- observed as 0x830001756e6b6e6f, which is
+ *    ASCII for the tail of the string "unknown" -- and phys_to_virt() of it is
+ *    unmapped, so fdt_check_header() takes a fault BEFORE it can reach the
+ *    panic() that was supposed to report the problem. The boot hangs with no
+ *    message at all. Requiring the address to land inside real DRAM first turns
+ *    a silent hang into a diagnosable one, and lets the pruned built-in tree be
+ *    used instead.
+ */
+#define FFN_FDT_BLOCK "__fdt"
+
+static __init bool ffn_fdt_usable(u64 phys, const char *how)
+{
+	u64 dram_end = (u64)octeon_bootinfo->dram_size << 20;
+	const void *virt;
+
+	if (!phys || phys >= dram_end) {
+		pr_warn("FFN: %s gives 0x%llx, outside DRAM (size 0x%llx) -- ignoring\n",
+			how, (unsigned long long)phys,
+			(unsigned long long)dram_end);
+		return false;
+	}
+
+	virt = phys_to_virt(phys);
+	if (fdt_check_header(virt)) {
+		pr_warn("FFN: %s gives 0x%llx, no valid FDT there -- ignoring\n",
+			how, (unsigned long long)phys);
+		return false;
+	}
+
+	return true;
+}
+
+static __init u64 ffn_fdt_locate(void)
+{
+	const struct cvmx_bootmem_named_block_desc *nb;
+	const char *arg;
+	u64 phys;
+
+	/* an explicit ffn_fdt= wins: the operator may know better */
+	arg = strstr(arcs_cmdline, "ffn_fdt=");
+	if (arg) {
+		phys = simple_strtoull(arg + sizeof("ffn_fdt=") - 1, NULL, 0);
+		if (ffn_fdt_usable(phys, "ffn_fdt=")) {
+			pr_info("FFN: using Device Tree from ffn_fdt=0x%llx\n",
+				(unsigned long long)phys);
+			return phys;
+		}
+	}
+
+	/* otherwise ask the bootmem descriptor where u-boot put it */
+	nb = cvmx_bootmem_find_named_block(FFN_FDT_BLOCK);
+	if (!nb)
+		return 0;
+
+	phys = nb->base_addr;
+	if (!ffn_fdt_usable(phys, "named block \"" FFN_FDT_BLOCK "\""))
+		return 0;
+
+	/*
+	 * A valid header does not mean the reservation is big enough for the
+	 * tree it claims -- check the declared size against the block.
+	 */
+	if ((u64)fdt_totalsize(phys_to_virt(phys)) > nb->size) {
+		pr_warn("FFN: named block \"%s\" is 0x%llx bytes but its FDT claims 0x%x -- ignoring\n",
+			FFN_FDT_BLOCK, (unsigned long long)nb->size,
+			fdt_totalsize(phys_to_virt(phys)));
+		return 0;
+	}
+
+	pr_info("FFN: Device Tree found by name: \"%s\" at 0x%llx (0x%x of 0x%llx bytes)\n",
+		FFN_FDT_BLOCK, (unsigned long long)phys,
+		fdt_totalsize(phys_to_virt(phys)),
+		(unsigned long long)nb->size);
+
+	return phys;
+}
