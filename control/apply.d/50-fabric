"""50-fabric -- program the BCM88375 switching fabric from config.

WHY THIS RUNS ON THE CP WHEN THE FABRIC BELONGS TO THE DATAPLANE
---------------------------------------------------------------
Under the plane split the forwarding fabric is the dataplane's, so its config
lives in the `dp.fabric.*` namespace and is authored as dataplane intent. But
the BCM88375 is physically on the **CP's** PCIe bus -- the DP cannot see it at
all, and its own PCIe is endpoint-mode facing the CP. So the CP applies it on
the dataplane's behalf.

That is the same shape as everything else DP-bound: the DP owns the intent, the
CP is the only one that can reach the hardware. Namespacing it `cp.*` because
the CP happens to hold the wire would encode a bus topology as an architecture.

Written in python3 (present on the CP) rather than sh because the programming
path is JSON over a socket, and parsing JSON in busybox sh is a way to get
subtly wrong answers quietly.

TRANSPORT: ffn-bcmd on 127.1.1.2:8104, which owns the single long-lived
bcm.user session. Never talk to the chip any other way from here -- the chip is
single-session and a second bcm.user wedges it.

KEYS
    dp.fabric.port.<name>.enable = 1|0
    dp.fabric.vlan.<vid>.ports   = xe5,xe8      (applied, untagged)
    dp.fabric.stp.forward        = xe5,xe8      (applied)

VLAN AND STP ARE APPLIED NOW. They were recorded-but-skipped for as long as
ffn-bcmd exposed only port enable and loopback; it now has vlan.create,
vlan.port.add and stp.set, so this hook programs them.

ONE FAILURE HERE IS NOT A BUG IN THIS HOOK. bcm_port_stp_set returns -18
(BCM_E_PORT) for any port that is not in the Ethernet class, and the class comes
from tm_port_header_type_in/out_<port> in config.bcm, which is read at init. So
a refused stp.forward means "edit config.bcm and re-init", never "retry". As
shipped ONLY PORT 3 is ETH; ports 5, 8 and 24 are TM/RAW. ffn-bcmd's stp.set
puts that explanation in its error text and this hook surfaces it verbatim
rather than reducing it to "failed". See bcm/ffn_bcm_l2.c.
"""
import json
import os
import socket
import sys

BCMD_HOST = os.getenv("FFN_BCMD_HOST", "127.1.1.2")
BCMD_PORT = int(os.getenv("FFN_BCMD_PORT", "8104"))

# argv[1] is cp.env -- what run_hooks passes every hook. But the fabric keys are
# dp.fabric.*, and ffn_cfgagent routes by scope:
#
#     cp_lines = cp.* + all.*   -> /etc/ffn/cp.env
#     dp_lines = dp.* + all.*   -> /etc/ffn/dp.env   (staged here, sent onward)
#
# So the fabric config is in dp.env, NOT the file this hook is handed. Reading
# only argv[1] would find nothing and report "nothing asked of us" forever --
# a silent no-op that looks like success. Both are read: dp.env for the fabric
# intent, cp.env for the legacy cp.bcm.* spelling and any CP-scoped override.
ENVFILE = sys.argv[1] if len(sys.argv) > 1 else "/etc/ffn/cp.env"
DPENV = os.getenv("FFN_DP_ENV", "/etc/ffn/dp.env")

# Fabric ports that must never be disabled by config.
#
# xl2 is the 40G trunk to the DATAPLANE. Disabling it does not "change the
# fabric", it orphans the dataplane -- the DP has no other path for traffic, and
# the CP would still look healthy while the box silently stopped forwarding.
# Exactly the ffnnet0 lesson, one layer down.
#
# Override only deliberately, via dp.fabric.protected in the curated base.
DEFAULT_PROTECTED = {"xl2"}


def log(msg):
    print("  [50-fabric] %s" % msg)


def warn(msg):
    sys.stderr.write("  [50-fabric] WARNING: %s\n" % msg)


def read_env(path):
    out = {}
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip()
    except OSError as exc:
        warn("cannot read %s: %s" % (path, exc))
    return out


def call(req, timeout=90.0):
    """One request to ffn-bcmd. Returns a dict; never raises for I/O."""
    try:
        s = socket.create_connection((BCMD_HOST, BCMD_PORT), timeout=10.0)
        s.settimeout(timeout)
        f = s.makefile("rwb")
        f.write((json.dumps(req) + "\n").encode())
        f.flush()
        line = f.readline()
        s.close()
    except (OSError, socket.timeout) as exc:
        return {"ok": False, "error": "bcmd unreachable", "detail": str(exc)}
    if not line:
        return {"ok": False, "error": "no reply from bcmd"}
    try:
        return json.loads(line.decode("utf-8", "replace"))
    except ValueError as exc:
        return {"ok": False, "error": "bad reply", "detail": str(exc)}


def main():
    env = read_env(ENVFILE)            # cp.env -- legacy keys, CP-scoped bits
    dpenv = read_env(DPENV)            # dp.env -- where the fabric intent lives
    fabric = {k: v for k, v in dpenv.items() if k.startswith("dp.fabric.")}
    # all.* appears in both files, so an override may be authored either way.
    env = dict(dpenv, **env)

    # Accept the pre-split spelling so an existing box keeps working, but say so
    # once: these keys describe the forwarding fabric, which is the dataplane's.
    legacy = {k: v for k, v in env.items() if k.startswith("cp.bcm.")}
    if legacy:
        warn("%d legacy cp.bcm.* key(s) found (%s). The fabric is the "
             "dataplane's: rename these to dp.fabric.* in the curated base."
             % (len(legacy), ", ".join(sorted(legacy))))

    if not fabric and not legacy:
        return 0                       # nothing asked of us; stay silent

    st = call({"op": "status"})
    if not st.get("ok"):
        warn("ffn-bcmd not answering (%s); fabric NOT applied"
             % st.get("error", "?"))
        return 0                       # never fail the whole apply run
    if st.get("state") != "ready":
        # init takes ~150 s. Not an error, just not now -- the agent re-runs
        # hooks on the next version change, and a retry is cheap.
        log("chip is '%s', not ready; skipping fabric this cycle" % st.get("state"))
        return 0

    pl = call({"op": "port.list"})
    if not pl.get("ok"):
        warn("cannot read the port table (%s); fabric NOT applied" % pl.get("error"))
        return 0
    by_name = {p["name"]: p for p in pl.get("ports", [])}

    protected = set(DEFAULT_PROTECTED)
    extra = env.get("dp.fabric.protected", "")
    if extra:
        protected |= {x.strip() for x in extra.split(",") if x.strip()}

    changed = skipped = 0
    for key, val in sorted(fabric.items()):
        rest = key[len("dp.fabric."):]

        if rest.startswith("port.") and rest.endswith(".enable"):
            name = rest[len("port."):-len(".enable")]
            want = val not in ("0", "false", "no", "")
            port = by_name.get(name)
            if port is None:
                warn("no such fabric port: %s" % name)
                continue
            if name in protected and not want:
                warn("refusing to disable %s: it is the dataplane trunk "
                     "(override with dp.fabric.protected)" % name)
                continue
            if port["enabled"] == want:
                continue               # already right
            r = call({"op": "port.set", "port": port["port"], "enable": want})
            if r.get("ok"):
                log("port %s (%d) %s" % (name, port["port"],
                                         "enabled" if want else "disabled"))
                changed += 1
            else:
                warn("port %s: %s" % (name, r.get("error")))

        elif rest.startswith("vlan.") and rest.endswith(".ports"):
            # dp.fabric.vlan.<vid>.ports = xe5,xe8
            #
            # Two calls, in this order: the VLAN has to exist before ports can
            # join it. vlan.create treats BCM_E_EXISTS as success, so a
            # re-applied configuration converges instead of erroring.
            #
            # Membership is untagged by default -- vlan.port.add puts every
            # listed port in both the member and untagged bitmaps unless told
            # otherwise. This chip's only working L2 domain has always been the
            # flat untagged VLAN 1, and a silently-tagged access port is a
            # much worse failure than an explicit one.
            vid_s = rest[len("vlan."):-len(".ports")]
            if not vid_s.isdigit():
                warn("bad vlan key (vid must be numeric): %s" % key)
                continue
            names = [x.strip() for x in str(val).split(",") if x.strip()]
            ports, unknown = [], []
            for n in names:
                p = by_name.get(n)
                (ports.append(p["port"]) if p else unknown.append(n))
            if unknown:
                warn("vlan %s: no such fabric port(s): %s"
                     % (vid_s, ", ".join(unknown)))
            if not ports:
                continue
            r = call({"op": "vlan.create", "vid": int(vid_s)})
            if not r.get("ok"):
                warn("vlan %s create: %s" % (vid_s, r.get("error")))
                continue
            r = call({"op": "vlan.port.add", "vid": int(vid_s), "ports": ports})
            if r.get("ok"):
                log("vlan %s: members %s (untagged)" % (vid_s, ports))
                changed += 1
            else:
                warn("vlan %s membership: %s" % (vid_s, r.get("error")))

        elif rest == "stp.forward":
            # dp.fabric.stp.forward = xe5,xe8
            #
            # A -18 from every port is not a transient error: the port is not
            # in the Ethernet class, which comes from
            # tm_port_header_type_in/out_<port> in config.bcm and is read at
            # init. ffn-bcmd's stp.set says so in its error, and that text is
            # surfaced verbatim rather than reduced to "failed", because the
            # fix is a config edit plus a re-init and nothing else.
            names = [x.strip() for x in str(val).split(",") if x.strip()]
            ports, unknown = [], []
            for n in names:
                p = by_name.get(n)
                (ports.append(p["port"]) if p else unknown.append(n))
            if unknown:
                warn("stp.forward: no such fabric port(s): %s" % ", ".join(unknown))
            if not ports:
                continue
            r = call({"op": "stp.set", "ports": ports, "state": "forward"})
            if r.get("ok"):
                got, bad = r.get("set", []), r.get("failed", [])
                log("stp forward: %s" % (got or "none"))
                if bad:
                    warn("stp forward refused for %s"
                         % ", ".join("%s(rv=%s %s)" % (b.get("port"), b.get("rv"),
                                                       b.get("meaning"))
                                     for b in bad))
                changed += len(got)
            else:
                warn("stp.forward: %s" % r.get("error"))

        elif rest.startswith("vlan.") or rest.startswith("stp."):
            warn("unrecognised vlan/stp key: %s" % key)
            skipped += 1

        elif rest == "protected":
            pass                       # consumed above

        else:
            warn("unrecognised fabric key: %s" % key)

    if skipped:
        log("%d fabric key(s) not applied" % skipped)
    log("%d fabric change(s)" % changed)
    return 0


if __name__ == "__main__":
    sys.exit(main())
