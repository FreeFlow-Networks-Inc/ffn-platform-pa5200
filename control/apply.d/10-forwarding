#
# IP forwarding, on the CONTROL PLANE where it belongs.
#
# This used to be the MP's job -- ffn_manager.py ran
# `sysctl -w net.ipv4.tcp_l3mdev_accept=1` and friends directly. Under the
# MP/CP/DP split the management plane orchestrates and holds config; it does not
# forward packets and should carry none of the machinery for it. So the sysctls
# move here and the MP only expresses the intent as cp.forwarding.*.
#
# Runs first (10-) because everything after it -- interfaces, VRFs, routes --
# is pointless on a box that will not forward.
set -u
. "$(dirname "$0")/00-common.sh"

# The loopback must be UP before anything else is worth doing.
#
# Found down on this CP, and the symptom is nasty: a connection to ANY local
# address is delivered via lo regardless of which interface owns the address, so
# with lo down the CP cannot reach its own services at all. ffn-bcmd was
# listening on 127.1.1.2:8104 and answering the MP perfectly, while a hook on
# the CP itself timed out connecting to exactly that address -- which reads like
# a daemon fault rather than a routing one.
#
# lo is in FFN_PROTECTED, which guards against flush/down. Bringing it UP is the
# opposite and is never harmful, so it is done directly rather than via safe_ip.
if ! ip link show lo 2>/dev/null | grep -q ",UP"; then
	ip link set lo up 2>/dev/null && log "loopback was DOWN; brought up"
fi

# Read/write a sysctl WITHOUT depending on the sysctl(8) binary.
#
# The Debian CP root has no sysctl -- it lives in procps, which is not
# installed -- so every setting here warned "could not set" while /proc/sys was
# perfectly writable. A forwarding hook that silently gives up because a
# convenience wrapper is missing is worse than one that pokes /proc, and the
# kernel interface is the stable one: /proc/sys has been there far longer than
# any given distro's package layout.
#
# sysctl is still preferred when present, because it honours
# /etc/sysctl.d and gives the same answer the operator gets by hand.
_sysctl_path() {
	# net.ipv4.ip_forward -> /proc/sys/net/ipv4/ip_forward
	printf '/proc/sys/%s\n' "$(printf '%s' "$1" | tr '.' '/')"
}

sysctl_get() {
	if command -v sysctl >/dev/null 2>&1; then
		sysctl -n "$1" 2>/dev/null && return 0
	fi
	_p=$(_sysctl_path "$1")
	[ -r "$_p" ] && cat "$_p" 2>/dev/null
}

sysctl_set() {
	if command -v sysctl >/dev/null 2>&1; then
		sysctl -w "$1=$2" >/dev/null 2>&1 && return 0
	fi
	_p=$(_sysctl_path "$1")
	[ -w "$_p" ] || return 1
	printf '%s\n' "$2" > "$_p" 2>/dev/null
}

apply_sysctl() {
	_k="$1"; _want="$2"
	[ -n "$_want" ] || return 0
	_have=$(sysctl_get "$_k")
	if [ "$_have" = "$_want" ]; then
		return 0                      # already right; say nothing
	fi
	if sysctl_set "$_k" "$_want"; then
		# Read it back. A write to /proc/sys can be accepted and ignored for
		# a key the running kernel does not implement, and reporting a change
		# that did not happen is the failure mode this whole hook exists to
		# avoid.
		_now=$(sysctl_get "$_k")
		if [ "$_now" = "$_want" ]; then
			log "$_k: ${_have:-unset} -> $_want"
		else
			warn "$_k accepted $_want but reads back '$_now'"
		fi
	else
		warn "could not set $_k=$_want (no sysctl binary and $(_sysctl_path "$_k") not writable)"
	fi
}

# The headline switch. Without this the CP is a host, not a router.
apply_sysctl net.ipv4.ip_forward           "$(get cp.forwarding.ipv4 0)"
apply_sysctl net.ipv6.conf.all.forwarding  "$(get cp.forwarding.ipv6 0)"

# l3mdev accept: makes sockets bound in the default VRF accept traffic arriving
# through a VRF device. Required for anything that terminates ON the CP while
# VRFs are in use -- without it, control-plane traffic that arrives via a VRF is
# silently not delivered, which presents as "the router forwards but you cannot
# reach it".
#
# Default EMPTY, not 0. apply_sysctl skips an empty value, so "not configured"
# means "do not touch" rather than "set it to 0" -- these sysctls only exist
# when the kernel has CONFIG_NET_L3_MASTER_DEV, and this CP kernel does not, so
# a 0 default made every single apply warn about a knob nobody asked for.
_l3=$(get cp.forwarding.l3mdev "")
if [ -n "$_l3" ]; then
	if [ -e /proc/sys/net/ipv4/tcp_l3mdev_accept ]; then
		apply_sysctl net.ipv4.tcp_l3mdev_accept "$_l3"
		apply_sysctl net.ipv4.udp_l3mdev_accept "$_l3"
	else
		# Asked for, but unavailable. Worth one clear line: a VRF will still
		# forward, but traffic terminating ON the CP via a VRF will not be
		# delivered, and that is a confusing symptom to meet later.
		warn "l3mdev requested but this kernel lacks it (CONFIG_NET_L3_MASTER_DEV);" \
		     "VRF-scoped traffic terminating on the CP will not be delivered"
	fi
fi

# rp_filter: strict reverse-path checking drops asymmetrically-routed traffic,
# which is normal on a firewall with multiple paths. Left at whatever the
# operator asked for rather than assumed, but reported when non-default so it is
# visible in the apply log rather than a mystery later.
_rp=$(get cp.forwarding.rp_filter "")
if [ -n "$_rp" ]; then
	apply_sysctl net.ipv4.conf.all.rp_filter "$_rp"
	[ "$_rp" = "1" ] && log "rp_filter=1 (strict): asymmetric paths will be dropped"
fi

exit 0
